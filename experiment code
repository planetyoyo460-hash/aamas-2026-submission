def render_leaderboard(agents: dict) -> str:
    rows = sorted(agents.values(), key=lambda a: -a.prestige)
    html = [
        '<table style="width:100%;border-collapse:collapse;font-size:11px">',
        '<tr style="background:#1e1e3f;color:#fff">'
        '<th style="padding:4px 6px;text-align:left">Role</th>'
        '<th>Side</th><th>Model</th><th>Prestige</th><th>Status</th></tr>',
    ]
    for a in rows:
        fc  = "#64b5f6" if a.faction == "Blue" else "#81c784"
        sc  = "#ef9a9a" if a.is_disqualified else "#81c784"
        st  = "DQ" if a.is_disqualified else "Active"
        html.append(
            f'<tr style="background:#1a1a2e;border-bottom:1px solid #333">'
            f'<td style="padding:4px 6px;color:#eee">{a.role}</td>'
            f'<td style="color:{fc};text-align:center">{a.faction}</td>'
            f'<td style="color:#aaa;font-size:10px"><code>{a.model_id}</code></td>'
            f'<td style="text-align:center">'
            f'<div style="background:#333;border-radius:3px;height:10px;width:60px;display:inline-block">'
            f'<div style="background:{fc};width:{int(a.prestige)}%;height:100%;border-radius:3px"></div>'
            f'</div> {a.prestige:.0f}</td>'
            f'<td style="text-align:center;color:{sc}">{st}</td></tr>'
        )
    html.append("</table>")
    return "".join(html)

