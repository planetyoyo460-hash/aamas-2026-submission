def generate_map(seed=42):
    rng = random.Random(seed)
    return {
        (r, c): {
            "terrain": rng.choices(TERRAIN_TYPES, TERRAIN_WEIGHTS)[0],
            "owner": "Blue" if c < MAP_COLS // 2 else "Green"
        }
        for r in range(MAP_ROWS) for c in range(MAP_COLS)
    }

def render_map_html(cells, blue: FactionState, green: FactionState) -> str:
    cw, ch = 54, 38
    svg = [
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{MAP_COLS*cw+20}" height="{MAP_ROWS*ch+20}">'
        f'<rect width="100%" height="100%" fill="#1a1a2e"/>'
    ]
    for (r, c), cell in cells.items():
        x, y = c*cw+10, r*ch+10
        bg = TERRAIN_COLOR.get(cell["terrain"], "#888")
        stroke = "#2196F3" if cell["owner"] == "Blue" else "#4caf50"
        svg.append(
            f'<rect x="{x}" y="{y}" width="{cw-2}" height="{ch-2}" rx="3" '
            f'fill="{bg}" stroke="{stroke}" stroke-width="1"/>'
            f'<text x="{x+3}" y="{y+11}" fill="#333" font-size="8" font-family="monospace">'
            f'{cell["terrain"].upper()[:4]}</text>'
        )
    svg.append('</svg>')
    stats = (
        f'<div style="display:flex;gap:24px;padding:8px 12px;background:#12122a;'
        f'color:#eee;font-size:12px;font-family:monospace">'
        f'<span style="color:#64b5f6">Blue — {blue.summary()}</span> | '
        f'<span style="color:#81c784">Green — {green.summary()}</span></div>'
    )
    return '<div style="overflow:auto">' + "".join(svg) + stats + "</div>"

