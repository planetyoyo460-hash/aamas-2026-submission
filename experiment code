                sim_state_cls = SimState,
                ping_fn       = _ping_model,
                known_models  = list(_KNOWN_MODELS),
                status_cb     = lambda m: print(f"[NightMode] {m}"),
                seed_start    = args.seed,
            )
        except KeyboardInterrupt:
            print("\n[⚡] Stopping Night Mode...")
            _nm.stop_night_mode()
            time.sleep(3)
            print("\n[⚡] Shutdown.")
            sys.exit(0)

    elif args.night and not _NM_AVAILABLE:
        print("[NightMode] ERROR: night_mode.py not found — cannot start Night Mode.")
        sys.exit(1)

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        _auto_run_active = False
        if _NM_AVAILABLE and _nm.night_mode_active:
            print("\n[⚡] Stopping Night Mode...")
            _nm.stop_night_mode()
            time.sleep(3)
        print("\n[⚡] Shutdown.")
