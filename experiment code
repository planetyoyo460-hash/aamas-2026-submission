# 11. HIERARCHICAL ROUTING
# ─────────────────────────────────────────────
def route_reports_up(agents: dict, faction: str, turn_decisions: dict) -> list[Message]:
    all_messages = []

    for role in [r for r in ROLES if r.startswith("Brigade")]:
        uid   = f"{faction}_{role.replace(' ', '_')}"
        agent = agents.get(uid)
        dec   = turn_decisions.get(uid)
        if not agent or agent.is_disqualified or not dec:
            continue
        sup_role = SUPERIOR_OF.get(role)
        if not sup_role:
            continue
        upward   = dec.get("upward_report", "No report.")
        true_rep = dec.get("true_report",   "No true report.")
        dist_level, dist_summary = _estimate_distortion(upward, true_rep)
        msg = Message(sender_role=role, recipient_role=sup_role,
                      content=upward, true_content=true_rep, distortion_level=dist_level)
        all_messages.append(msg)
        sup_uid = f"{faction}_{sup_role.replace(' ', '_')}"
        sup = agents.get(sup_uid)
        if sup and not sup.is_disqualified:
            sup.inbox.append(f"[FROM {role}] {upward}  [distortion={dist_level:.2f}: {dist_summary}]")

    for role in [r for r in ROLES if r.startswith("Major")]:
        uid   = f"{faction}_{role.replace(' ', '_')}"
        agent = agents.get(uid)
        dec   = turn_decisions.get(uid)
        if not agent or agent.is_disqualified:
            continue
        sup_role = SUPERIOR_OF.get(role)
        if not sup_role:
            continue
        own_report = dec.get("upward_report", "") if dec else ""
        own_true   = dec.get("true_report",   "") if dec else ""
        sub_reports = "\n".join(agent.inbox[-4:]) if agent.inbox else "No subordinate reports."
        forwarded = f"{own_report} | Sub-reports: {sub_reports[:200]}"
        true_fwd  = f"Own: {own_true} | Subs: {sub_reports[:200]}"
        dist_level, dist_summary = _estimate_distortion(forwarded, true_fwd)
        msg = Message(sender_role=role, recipient_role=sup_role,
                      content=forwarded, true_content=true_fwd, distortion_level=dist_level)
        all_messages.append(msg)
        sup_uid = f"{faction}_{sup_role.replace(' ', '_')}"
        sup = agents.get(sup_uid)
        if sup and not sup.is_disqualified:
            sup.inbox.append(f"[FROM {role}] {forwarded[:300]}  [distortion={dist_level:.2f}: {dist_summary}]")

    return all_messages

