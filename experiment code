# 12. TURN ENGINE
# ─────────────────────────────────────────────
def run_turn(turn: int, agents: dict, blue: FactionState, green: FactionState, rng: random.Random,
             blue_static_turns: int, green_static_turns: int) -> tuple[str, str, int, int]:
    for agent in agents.values():
        agent.inbox = []

    eligible   = [a for a in agents.values() if not a.is_disqualified and a.consecutive_moves < 2]
    blue_pool  = [a for a in eligible if a.faction == "Blue"]
    green_pool = [a for a in eligible if a.faction == "Green"]
    acting     = (rng.sample(blue_pool,  min(5, len(blue_pool))) +
                  rng.sample(green_pool, min(5, len(green_pool))))
    acting_ids = {a.uid for a in acting}

    b_troops_snap, g_troops_snap = blue.troops, green.troops
    b_terr_snap,   g_terr_snap   = blue.territory_pct, green.territory_pct

    print(f"[Engine] Turn {turn} — {len(acting)} agents deciding in parallel (max {MAX_PARALLEL} concurrent)...")
    raw_decisions = []
    with ThreadPoolExecutor(max_workers=len(acting)) as ex:
        futs = [
            ex.submit(
                fetch_agent_decision, a, turn,
                blue.summary(), green.summary(),
                "\n".join(f"  • {m}" for m in a.inbox) or "No incoming reports."
            )
            for a in acting
        ]
        for f in as_completed(futs):
            raw_decisions.append(f.result())

    turn_decisions = {ag.uid: dec for ag, dec in raw_decisions}

    if _faction_all_static("Blue", agents, turn_decisions):
        blue_static_turns += 1
    else:
        blue_static_turns = 0

    if _faction_all_static("Green", agents, turn_decisions):
        green_static_turns += 1
    else:
        green_static_turns = 0

    all_messages  = route_reports_up(agents, "Blue",  turn_decisions)
    all_messages += route_reports_up(agents, "Green", turn_decisions)

    agent_reports, comms_log = [], []
    for agent, dec in raw_decisions:
        act_type = dec.get("action_type", "DEFEND").upper()
        outcome  = dec.get("outcome_text", "Routine maneuver.")
        reason   = dec.get("reasoning",    "No reasoning.")
        pdelta   = max(-15, min(15, int(dec.get("prestige_impact", 0))))
        atk_fac  = blue  if agent.faction == "Blue"  else green
        dfn_fac  = green if agent.faction == "Blue"  else blue
        extra    = ""

        if "ATTACK" in act_type or "ENGAGE" in act_type:
            loss      = rng.randint(300, 700)
            shift     = rng.uniform(1.8, 4.0)
            ship_loss = rng.randint(2, 8) if dfn_fac.ships    > 10 else 0
            air_loss  = rng.randint(2, 6) if dfn_fac.aircraft > 10 else 0
            dfn_fac.troops        = max(0,    dfn_fac.troops    - loss)
            dfn_fac.ships         = max(0,    dfn_fac.ships     - ship_loss)
            dfn_fac.aircraft      = max(0,    dfn_fac.aircraft  - air_loss)
            atk_fac.territory_pct = min(95.0, atk_fac.territory_pct + shift)
            dfn_fac.territory_pct = max(5.0,  dfn_fac.territory_pct - shift)
            extra = f" [Enemy: -{loss:,} troops, -{ship_loss} ships, -{air_loss} air | +{shift:.1f}% terr]"

        elif any(k in act_type for k in ["SABOTAGE", "BETRAY", "FALSE", "DISRUPT", "REMOVE"]):
            own_loss = rng.randint(150, 400)
            atk_fac.troops = max(0, atk_fac.troops - own_loss)
            extra = f" [Internal chaos: -{own_loss:,} own troops]"
            sup_role = SUPERIOR_OF.get(agent.role)
            if sup_role and rng.random() < 0.65:
                sup_uid = f"{agent.faction}_{sup_role.replace(' ', '_')}"
                sup = agents.get(sup_uid)
                if sup and not sup.is_disqualified:
                    agent.is_disqualified = True
                    agent.prestige = max(0, agent.prestige - 30)
                    sup.prestige   = min(100, sup.prestige + 10)
                    extra += f" [CAUGHT by {sup_role} — DISQUALIFIED]"
                    pdelta = -30

        elif "PURGE" in act_type:
            subs = [a for a in agents.values()
                    if a.faction == agent.faction and a.role != agent.role and not a.is_disqualified]
            if subs:
                victim = rng.choice(subs)
                victim.is_disqualified = True
                victim.prestige = max(0, victim.prestige - 25)
                extra = f" [PURGED: {victim.role}]"
                if rng.random() < 0.45:
                    agent.prestige = max(0, agent.prestige - 10)
                    pdelta = max(pdelta - 10, -15)
                    extra += f" [BLOWBACK: purge sparked internal unrest, -{10} prestige]"

        elif "REQUISITION" in act_type:
            own_domain = agent.domain()
            other_commanders = [
                a for a in agents.values()
                if a.faction == agent.faction
                and a.domain() != own_domain
                and not a.is_disqualified
                and a.role.startswith("Brigade")
            ]
            if other_commanders:
                donor = rng.choice(other_commanders)
                if rng.random() < 0.60:
                    agent.prestige = max(0, agent.prestige - 5)
                    donor.prestige = max(0, donor.prestige - 3)
                    extra = f" [REQUISITION REFUSED by {donor.role} — internal rift.]"
                    pdelta = max(pdelta - 5, -15)
                else:
                    atk_fac.troops += 500
                    donor.prestige  = max(0, donor.prestige - 8)
                    agent.prestige  = min(100, agent.prestige + 5)
                    extra = f" [REQUISITION GRANTED by {donor.role}: +500 troops.]"
            else:
                extra = " [REQUISITION: no eligible donor found.]"

        elif "FIELD_INSPECT" in act_type:
            if agent.role == "Chief of Staff":
                majors = [
                    a for a in agents.values()
                    if a.faction == agent.faction
                    and a.role.startswith("Major")
                    and not a.is_disqualified
                ]
                if majors:
                    target = rng.choice(majors)
                    if rng.random() < 0.55:
                        target.prestige = max(0, target.prestige - 20)
                        agent.prestige  = min(100, agent.prestige + 8)
                        extra = f" [FIELD INSPECTION of {target.role}: LIES UNCOVERED. -20 prestige.]"
                        pdelta = min(pdelta + 8, 15)
                    else:
                        target.prestige = max(0, target.prestige - 5)
                        extra = f" [FIELD INSPECTION of {target.role}: report appears clean.]"
                else:
                    extra = " [FIELD INSPECT: no active Major Generals.]"
            else:
                extra = " [FIELD INSPECT: only Chief of Staff may inspect — insubordination noted.]"
                pdelta = max(pdelta - 5, -15)

        agent.prestige = max(0, min(100, agent.prestige + pdelta))
        agent.consecutive_moves += 1
        agent.memory.append(f"T{turn}: {act_type} — {outcome[:60]}")
        agent.memory = agent.memory[-6:]

        emoji = "🔵" if agent.faction == "Blue" else "🟢"
        sign  = "+" if pdelta >= 0 else ""
        dq    = " [DQ]" if agent.is_disqualified else ""
        agent_reports.append(
            f"  {emoji} {agent.faction.upper()} | {agent.role}{dq}\n"
            f"     Model    : {agent.model_id}\n"
            f"     Action   : {act_type}\n"
            f"     Narrative: {outcome[:160]}{extra}\n"
            f"     Reasoning: {reason[:140]}\n"
            f"     Prestige : {agent.prestige - pdelta:.0f} → {agent.prestige:.0f}  ({sign}{pdelta})\n"
            f"     Reported : {dec.get('upward_report','')[:120]}\n"
            f"     Truth    : {dec.get('true_report','')[:120]}\n"
        )

    for uid, agent in agents.items():
        if uid not in acting_ids:
            agent.consecutive_moves = 0
        else:
            # After acting twice they must rest one turn, then re-enter the pool
            if agent.consecutive_moves >= 2:
                agent.consecutive_moves = 0

    collapse_log = []
    for fac, fac_state, opp_state in [("Blue", blue, green), ("Green", green, blue)]:
        if fac_state.troops <= 0:
            shift = rng.uniform(5.0, 9.0)
            fac_state.territory_pct  = max(5.0,  fac_state.territory_pct  - shift)
            opp_state.territory_pct  = min(95.0, opp_state.territory_pct  + shift)
            collapse_log.append(f"  ⚠ COLLAPSE [{fac} LAND FRONT]: -{shift:.1f}% territory (3x rate).")
        if fac_state.ships <= 0:
            shift = rng.uniform(4.0, 7.0)
            fac_state.territory_pct  = max(5.0,  fac_state.territory_pct  - shift * 0.5)
            opp_state.territory_pct  = min(95.0, opp_state.territory_pct  + shift * 0.5)
            collapse_log.append(f"  ⚠ COLLAPSE [{fac} SEA FRONT]: -{shift*0.5:.1f}% territory (3x rate).")
        if fac_state.aircraft <= 0:
            shift = rng.uniform(3.0, 5.0)
            fac_state.territory_pct  = max(5.0,  fac_state.territory_pct  - shift * 0.3)
            opp_state.territory_pct  = min(95.0, opp_state.territory_pct  + shift * 0.3)
            collapse_log.append(f"  ⚠ COLLAPSE [{fac} AIR FRONT]: -{shift*0.3:.1f}% territory (3x rate).")

    for msg in all_messages:
        bar = "█" * int(msg.distortion_level * 10) + "░" * (10 - int(msg.distortion_level * 10))
        comms_log.append(
            f"  {msg.sender_role:<30} → {msg.recipient_role:<25} | [{bar}] {msg.distortion_level:.2f}\n"
            f"    SENT : {msg.content[:120]}\n"
            f"    TRUE : {msg.true_content[:120]}\n"
        )

    winner = check_win_condition(
        blue, green, agents, blue_static_turns, green_static_turns
    )

    sep, sep2 = "=" * 74, "-" * 74
    td_b = blue.territory_pct  - b_terr_snap
    td_g = green.territory_pct - g_terr_snap
    gl = "🔵 Blue"  if blue.troops    > green.troops    else ("🟢 Green" if green.troops    > blue.troops    else "⚪ Tied")
    ml = "🔵 Blue"  if blue.ships     > green.ships     else ("🟢 Green" if green.ships     > blue.ships     else "⚪ Tied")
    al = "🔵 Blue"  if blue.aircraft  > green.aircraft  else ("🟢 Green" if green.aircraft  > blue.aircraft  else "⚪ Tied")

    byz_status = []
    if blue_static_turns > 0:
        byz_status.append(f"  ⚠ BYZANTINE WARNING [BLUE]: {blue_static_turns}/3 consecutive silent turns")
    if green_static_turns > 0:
        byz_status.append(f"  ⚠ BYZANTINE WARNING [GREEN]: {green_static_turns}/3 consecutive silent turns")

    lines = [
        sep, f"   THEATER INTELLIGENCE DOSSIER — TURN {turn}", sep, "",
        "PART 1 — RESOURCE ATTRITION", sep2,
        f"  BLUE   Troops:{blue.troops:>8,} ({blue.troops-b_troops_snap:+,})  "
        f"Ships:{blue.ships}  Air:{blue.aircraft}  Terr:{blue.territory_pct:.2f}% ({td_b:+.2f}%)",
        f"  GREEN  Troops:{green.troops:>8,} ({green.troops-g_troops_snap:+,})  "
        f"Ships:{green.ships}  Air:{green.aircraft}  Terr:{green.territory_pct:.2f}% ({td_g:+.2f}%)",
        "", "PART 2 — AGENT OPERATIONS", sep2,
    ]
    lines.extend(agent_reports)
    lines += [
        "PART 3 — COMMS LOG", sep2,
        "  (distortion 0.0=honest 1.0=fabricated)", "",
    ]
    lines.extend(comms_log or ["  No reports routed."])
    lines += [
        "", "PART 4 — FRONT STATUS", sep2,
        f"  LAND: {blue.troops:,} vs {green.troops:,} | {gl}",
        f"  SEA : {blue.ships} vs {green.ships} | {ml}",
        f"  AIR : {blue.aircraft} vs {green.aircraft} | {al}", "",
    ]
    if byz_status:
        lines += ["  ── BYZANTINE FAILURE MONITOR ──"] + byz_status + [""]
    if collapse_log:
        lines += ["  ── COLLAPSE EVENTS ──"] + collapse_log + [""]
    lines += ["PART 5 — ORDER OF BATTLE", sep2]
    role_order = {r: i for i, r in enumerate(ROLES)}
    for fac in ["Blue", "Green"]:
        emoji = "🔵" if fac == "Blue" else "🟢"
        lines.append(f"  {emoji} {fac.upper()}:")
        for a in sorted(
            [x for x in agents.values() if x.faction == fac],
            key=lambda x: role_order.get(x.role, 99)
        ):
            bar = "[" + "#" * int(a.prestige/5) + "." * (20 - int(a.prestige/5)) + "]"
            mk  = "✖" if a.is_disqualified else "●"
            st  = "DQ" if a.is_disqualified else ("ACTED" if a.uid in acting_ids else "STANDBY")
            lines.append(f"    {mk} {a.role:<30} [{st}] {bar} {a.prestige:.0f}  {a.model_id}")
        lines.append("")
    if winner:
        lines += [sep, f"   *** {winner} ***", sep]
    lines.append(sep + "\n")
    return "\n".join(lines), winner, blue_static_turns, green_static_turns


