@dataclass
class Message:
    sender_role: str
    recipient_role: str
    content: str
    true_content: str
    distortion_level: float = 0.0

@dataclass
class Agent:
    faction: str
    role: str
    model_id: str
    prestige: float = 50.0
    is_disqualified: bool = False
    consecutive_moves: int = 0
    memory: list = field(default_factory=list)
    inbox: list = field(default_factory=list)

    @property
    def uid(self): return f"{self.faction}_{self.role.replace(' ', '_')}"
    def domain(self): return DOMAIN_OF.get(self.role, "land")
    def rank_level(self): return RANK_LEVEL.get(self.role, 1)

@dataclass
class FactionState:
    faction: str
    troops: int = 10_000
    ships: int = 200
    aircraft: int = 100
    territory_pct: float = 50.0
    def summary(self):
        return f"Troops={self.troops:,} | Ships={self.ships} | Aircraft={self.aircraft} | Territory={self.territory_pct:.1f}%"

