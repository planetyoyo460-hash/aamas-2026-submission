def init_sim(seed_str: str):
    seed = int(seed_str.strip()) if seed_str.strip().isdigit() else 42
    wr = warmup_all_models()
    SIM.reset(seed)
    if wr:
        ok    = sum(wr.values())
        total = len(wr)
        lines = [f"Initialized — {ok}/{total} models ready.\n"]
        lines += [f"  {'✔' if flag else '✘'}  {mid}" for mid, flag in sorted(wr.items())]
        if ok == 0:
            lines += [
                "",
                "⚠ WARNING: No models responded.",
                "Possible causes:",
                "  • GitHub token lacks 'models:read' permission",
                "  • Rate limit hit during warmup — try again in 60s",
                "  • Network/proxy blocking api.github.com",
            ]
        lines.append("\nReady for Turn 1." if ok > 0 else "\nSimulation will use static DEFEND fallback.")
        msg = "\n".join(lines)
    else:
        msg = "Initialized (no token — warmup skipped). Using static DEFEND fallback."
    return (
        render_map_html(SIM.cells, SIM.blue, SIM.green),
        msg,
        render_leaderboard(SIM.agents),
        "",
        gr.update(interactive=True),
        gr.update(interactive=True),
    )


def reset_sim(seed_str: str):
    seed = int(seed_str.strip()) if seed_str.strip().isdigit() else 42
    with _LOCK:
        SIM.reset(seed)
    return (
        render_map_html(SIM.cells, SIM.blue, SIM.green),
        "Simulation reset — model assignments reshuffled. Ready for Turn 1.",
        render_leaderboard(SIM.agents),
        "",
        gr.update(interactive=True),
        gr.update(interactive=True),
    )


def next_turn(seed_str: str):
    with _LOCK:
        if not SIM.initialized:
            yield (
                "", "Initialize first.", "",
                "", gr.update(interactive=True), gr.update(interactive=True)
            )
            return
        if SIM.game_over:
            yield (
                render_map_html(SIM.cells, SIM.blue, SIM.green),
                "Game over — press Reset to start a new simulation.",
                render_leaderboard(SIM.agents),
                build_endgame_summary(SIM.winner, SIM.turn, SIM.agents, SIM.blue, SIM.green),
                gr.update(interactive=False),
                gr.update(interactive=True),
            )
            return
        if not GITHUB_TOKEN:
            yield (
                "", "ERROR: GITHUB_TOKEN not set in .env", "",
                "", gr.update(interactive=True), gr.update(interactive=True)
            )
            return
        SIM.turn += 1
        turn = SIM.turn

    rng = random.Random(turn * 7919)
    log, winner, bst, gst = run_turn(
        turn, SIM.agents, SIM.blue, SIM.green, rng,
        SIM.blue_static_turns, SIM.green_static_turns
    )
    with _LOCK:
        SIM.blue_static_turns  = bst
        SIM.green_static_turns = gst
        if winner:
            SIM.game_over = True
            SIM.winner    = winner

    endgame_html = ""
    turn_btn_state = gr.update(interactive=True)
    if winner:
        endgame_html   = build_endgame_summary(winner, turn, SIM.agents, SIM.blue, SIM.green)
        turn_btn_state = gr.update(interactive=False)

    yield (
        render_map_html(SIM.cells, SIM.blue, SIM.green),
        log,
        render_leaderboard(SIM.agents),
        endgame_html,
        turn_btn_state,
        gr.update(interactive=True),
    )

