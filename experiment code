def _ping_model(mid: str) -> tuple[str, bool, float]:
    """Standalone ping used by warmup AND night_mode health-checks."""
    start = time.time()
    try:
        _call_model(mid, [
            {"role": "system", "content": "You are a military commander. Reply in JSON only."},
            {"role": "user",   "content": (
                'Output exactly this JSON: '
                '{"action_type":"ATTACK","outcome_text":"test",'
                '"reasoning":"test","prestige_impact":5,'
                '"upward_report":"test","true_report":"test"}'
            )},
        ], max_tokens=60)
        return mid, True, time.time() - start
    except Exception:
        return mid, False, time.time() - start


def warmup_all_models() -> dict:
    if not GITHUB_TOKEN:
        print("[Warmup] Skipped — no token.")
        return {}
    global AVAILABLE_MODELS, FALLBACK_MODELS

    AVAILABLE_MODELS = list(_KNOWN_MODELS)
    print(f"[Warmup] Pinging {len(AVAILABLE_MODELS)} models (max {MAX_PARALLEL} parallel)...")

    results = {}
    timings = {}

    with ThreadPoolExecutor(max_workers=MAX_PARALLEL) as pool:
        for mid, ok, elapsed in pool.map(_ping_model, AVAILABLE_MODELS):
            print(f"  [Warmup] {'✔' if ok else '✘'} {mid:<50} {elapsed:.1f}s")
            results[mid] = ok
            timings[mid] = elapsed

    working = sorted(
        [(mid, timings[mid]) for mid, ok in results.items() if ok],
        key=lambda x: x[1]
    )
    FALLBACK_MODELS = [mid for mid, _ in working]
    print(f"[Warmup] {len(FALLBACK_MODELS)}/{len(results)} ready.")
    if FALLBACK_MODELS:
        print(f"[Warmup] Working models: {FALLBACK_MODELS}")
    else:
        print("[Warmup] WARNING: No models responded — check token permissions and network.")
    return results

