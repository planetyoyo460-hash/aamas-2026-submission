# 8. DISTORTION
# ─────────────────────────────────────────────
def _estimate_distortion(upward: str, true_rep: str) -> tuple[float, str]:
    if not upward or not true_rep:
        return 0.0, "No report."
    def words(s): return set(s.lower().split())
    w1, w2 = words(upward), words(true_rep)
    if not w1 or not w2:
        return 0.0, "Empty report."
    overlap = len(w1 & w2) / max(len(w1 | w2), 1)
    score = round(1.0 - overlap, 2)
    if score > 0.7:
        summary = "Heavy fabrication."
    elif score > 0.4:
        summary = "Significant omissions detected."
    elif score > 0.2:
        summary = "Minor distortions."
    else:
        summary = "Report largely accurate."
    return score, summary

