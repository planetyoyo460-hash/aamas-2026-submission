def build_endgame_summary(winner: str, turn: int, agents: dict,
                           blue: FactionState, green: FactionState) -> str:
    blue_agents = sorted(
        [a for a in agents.values() if a.faction == "Blue"],
        key=lambda a: -a.prestige
    )
    green_agents = sorted(
        [a for a in agents.values() if a.faction == "Green"],
        key=lambda a: -a.prestige
    )

    def agent_rows(agent_list):
        rows = []
        for a in agent_list:
            color = "#64b5f6" if a.faction == "Blue" else "#81c784"
            status = "💀 DQ" if a.is_disqualified else "✔ Active"
            bar_w  = int(a.prestige)
            rows.append(
                f'<tr style="border-bottom:1px solid #333">'
                f'<td style="padding:3px 8px;color:#eee">{a.role}</td>'
                f'<td style="color:#aaa;font-size:10px"><code>{a.model_id}</code></td>'
                f'<td style="text-align:center">'
                f'<div style="background:#333;border-radius:3px;height:8px;width:70px;display:inline-block;vertical-align:middle">'
                f'<div style="background:{color};width:{bar_w}%;height:100%;border-radius:3px"></div>'
                f'</div> <span style="color:{color}">{a.prestige:.0f}</span></td>'
                f'<td style="text-align:center;color:#aaa;font-size:10px">{status}</td>'
                f'</tr>'
            )
        return "".join(rows)

    blue_dq  = sum(1 for a in blue_agents  if a.is_disqualified)
    green_dq = sum(1 for a in green_agents if a.is_disqualified)
    blue_avg  = sum(a.prestige for a in blue_agents)  / max(len(blue_agents),  1)
    green_avg = sum(a.prestige for a in green_agents) / max(len(green_agents), 1)

    winner_color = "#64b5f6" if "BLUE" in winner else ("#81c784" if "GREEN" in winner else "#aaaaaa")

    html = f"""
<div style="background:#0d0d1a;color:#eee;font-family:monospace;padding:20px;border-radius:8px;border:2px solid {winner_color}">
  <h2 style="color:{winner_color};text-align:center;margin-bottom:4px">⚔ SIMULATION COMPLETE — TURN {turn}</h2>
  <p style="text-align:center;font-size:16px;color:{winner_color};margin-top:0">{winner}</p>
  <hr style="border-color:#333;margin:12px 0"/>

  <div style="display:flex;gap:20px;margin-bottom:16px">
    <div style="flex:1;background:#12122a;padding:10px;border-radius:6px;border-left:3px solid #64b5f6">
      <b style="color:#64b5f6">🔵 BLUE FINAL STATE</b><br/>
      Troops: <b>{blue.troops:,}</b><br/>
      Ships: <b>{blue.ships}</b> | Air: <b>{blue.aircraft}</b><br/>
      Territory: <b>{blue.territory_pct:.1f}%</b><br/>
      Commanders DQ'd: <b>{blue_dq}/{len(blue_agents)}</b><br/>
      Avg Prestige: <b>{blue_avg:.1f}</b>
    </div>
    <div style="flex:1;background:#12122a;padding:10px;border-radius:6px;border-left:3px solid #81c784">
      <b style="color:#81c784">🟢 GREEN FINAL STATE</b><br/>
      Troops: <b>{green.troops:,}</b><br/>
      Ships: <b>{green.ships}</b> | Air: <b>{green.aircraft}</b><br/>
      Territory: <b>{green.territory_pct:.1f}%</b><br/>
      Commanders DQ'd: <b>{green_dq}/{len(green_agents)}</b><br/>
      Avg Prestige: <b>{green_avg:.1f}</b>
    </div>
  </div>

  <b style="color:#64b5f6">🔵 BLUE FINAL LEADERBOARD</b>
  <table style="width:100%;border-collapse:collapse;font-size:11px;margin-bottom:12px">
    <tr style="background:#1e1e3f;color:#aaa"><th style="padding:3px 8px;text-align:left">Role</th>
    <th>Model</th><th>Prestige</th><th>Status</th></tr>
    {agent_rows(blue_agents)}
  </table>

  <b style="color:#81c784">🟢 GREEN FINAL LEADERBOARD</b>
  <table style="width:100%;border-collapse:collapse;font-size:11px">
    <tr style="background:#1e1e3f;color:#aaa"><th style="padding:3px 8px;text-align:left">Role</th>
    <th>Model</th><th>Prestige</th><th>Status</th></tr>
    {agent_rows(green_agents)}
  </table>

  <p style="text-align:center;color:#555;margin-top:12px;font-size:10px">
    Press <b>Reset Simulation</b> to start a new game.
  </p>
</div>
"""
    return html


