AUTO_RUN_LOG_DIR  = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wargame_logs")
CATALOG_JSON_PATH = os.path.join(AUTO_RUN_LOG_DIR, "catalog.json")
CATALOG_TXT_PATH  = os.path.join(AUTO_RUN_LOG_DIR, "catalog_summary.txt")

_catalog_lock = threading.Lock()


def _load_catalog() -> list:
    """Load existing catalog entries from disk (returns list, newest-last)."""
    try:
        with open(CATALOG_JSON_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return []


def _build_catalog_entry(
    sim_index: int,
    seed: int,
    turn: int,
    winner: str,
    blue: FactionState,
    green: FactionState,
    agents: dict,
    turn_logs: list[dict],
    started_at: str,
    ended_at: str,
    duration_seconds: float,
) -> dict:
    # ── Determine win condition type ──────────────────────────────────────
    if "Territorial" in winner:
        win_condition = "TERRITORIAL_DOMINANCE"
    elif "annihilated" in winner:
        win_condition = "ANNIHILATION"
    elif "Byzantine" in winner:
        win_condition = "BYZANTINE_FAILURE"
    elif "DRAW" in winner:
        win_condition = "DRAW"
    else:
        win_condition = "UNKNOWN"

    # ── Winner faction ────────────────────────────────────────────────────
    winner_faction = "Blue" if "BLUE" in winner else ("Green" if "GREEN" in winner else "Draw")

    # ── Per-agent final stats ─────────────────────────────────────────────
    agents_final = []
    for a in sorted(agents.values(), key=lambda x: (x.faction, x.role)):
        agents_final.append({
            "faction":         a.faction,
            "role":            a.role,
            "model":           a.model_id,
            "final_prestige":  round(a.prestige, 1),
            "disqualified":    a.is_disqualified,
            "memory_entries":  len(a.memory),
        })

    # ── Model participation stats ─────────────────────────────────────────
    model_stats: dict[str, dict] = {}
    for tl in turn_logs:
        for act in tl.get("actions_taken", []):
            mid = act["model"]
            if mid not in model_stats:
                model_stats[mid] = {
                    "model": mid, "turns_active": 0,
                    "total_prestige_delta": 0,
                    "action_counts": {},
                    "factions_played": set(),
                }
            ms = model_stats[mid]
            ms["turns_active"] += 1
            ms["total_prestige_delta"] += act.get("prestige_delta", 0)
            atype = act.get("action_type", "UNKNOWN")
            ms["action_counts"][atype] = ms["action_counts"].get(atype, 0) + 1
            ms["factions_played"].add(act["faction"])

    for ms in model_stats.values():
        ms["factions_played"] = sorted(ms["factions_played"])

    # ── Turn-by-turn battlefield trajectory ──────────────────────────────
    trajectory = []
    for tl in turn_logs:
        trajectory.append({
            "turn":             tl["turn"],
            "blue_troops":      tl["blue_troops"],
            "blue_ships":       tl["blue_ships"],
            "blue_aircraft":    tl["blue_aircraft"],
            "blue_territory":   round(tl["blue_territory"], 2),
            "green_troops":     tl["green_troops"],
            "green_ships":      tl["green_ships"],
            "green_aircraft":   tl["green_aircraft"],
            "green_territory":  round(tl["green_territory"], 2),
            "territory_delta":  round(tl["blue_territory"] - tl["green_territory"], 2),
        })

    # ── Aggregate combat stats ────────────────────────────────────────────
    total_attacks    = sum(
        sum(1 for a in tl.get("actions_taken", []) if "ATTACK" in a.get("action_type","") or "ENGAGE" in a.get("action_type",""))
        for tl in turn_logs
    )
    total_sabotages  = sum(
        sum(1 for a in tl.get("actions_taken", [])
            if any(k in a.get("action_type","") for k in ("SABOTAGE","FALSE","BETRAY")))
        for tl in turn_logs
    )
    total_dq          = sum(1 for a in agents.values() if a.is_disqualified)
    blue_dq           = sum(1 for a in agents.values() if a.faction=="Blue"  and a.is_disqualified)
    green_dq          = sum(1 for a in agents.values() if a.faction=="Green" and a.is_disqualified)
    blue_avg_prestige = (
        sum(a.prestige for a in agents.values() if a.faction=="Blue") /
        max(sum(1 for a in agents.values() if a.faction=="Blue"), 1)
    )
    green_avg_prestige = (
        sum(a.prestige for a in agents.values() if a.faction=="Green") /
        max(sum(1 for a in agents.values() if a.faction=="Green"), 1)
    )

    unique_models = sorted({a.model_id for a in agents.values()})

    entry = {
