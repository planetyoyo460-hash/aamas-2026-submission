GITHUB_ENDPOINT = "https://models.inference.ai.azure.com"
MODEL_TIMEOUT   = 45
MAX_ATTEMPTS    = 3
MAX_PARALLEL    = 4

_api_semaphore = threading.Semaphore(MAX_PARALLEL)
_client_lock   = threading.Lock()
_shared_client: Optional[ChatCompletionsClient] = None

def _get_client() -> ChatCompletionsClient:
    global _shared_client
    if _shared_client is None:
        with _client_lock:
            if _shared_client is None:
                _shared_client = ChatCompletionsClient(
                    endpoint=GITHUB_ENDPOINT,
                    credential=AzureKeyCredential(GITHUB_TOKEN),
                )
    return _shared_client

def _reset_client():
    global _shared_client
    with _client_lock:
        _shared_client = None

def _call_model(model_id: str, messages: list, max_tokens: int) -> str:
    last_error = None

    with _api_semaphore:
        for attempt in range(3):
            result_box, error_box = [None], [None]

            def _run():
                try:
                    r = _get_client().complete(
                        messages=messages,
                        model=model_id,
                        temperature=1.0,
                        max_tokens=max_tokens,
                    )
                    result_box[0] = r.choices[0].message.content.strip()
                except Exception as e:
                    error_box[0] = e
                    err_str = str(e).lower()
                    if any(k in err_str for k in ("connectionreset", "connection aborted",
                                                   "broken pipe", "connection error")):
                        _reset_client()

            t = threading.Thread(target=_run, daemon=True)
            t.start()
            t.join(timeout=MODEL_TIMEOUT)

            if t.is_alive():
                raise TimeoutError(f"{model_id} timed out after {MODEL_TIMEOUT}s")

            if result_box[0] is not None:
                return result_box[0]

            err = error_box[0]
            last_error = err
            err_str = str(err).lower()

            print(f"  [RAW ERROR attempt {attempt+1}] {model_id}: {type(err).__name__}: {err}")

            if any(k in err_str for k in ("429", "rate limit", "too many requests",
                                           "connectionreset", "connection aborted")):
                wait = 2 ** attempt
                print(f"  [RETRY in {wait}s] {model_id}")
                time.sleep(wait)
                continue

            raise err

        raise last_error or RuntimeError(f"{model_id}: unknown failure after retries")


def call_model(model_id: str, system: str, user: str, max_tokens: int = 300) -> str:
    if not GITHUB_TOKEN:
        return _static_defend("No GITHUB_TOKEN.")
    msgs = [{"role": "system", "content": system}, {"role": "user", "content": user}]
    queue = [model_id] + [m for m in FALLBACK_MODELS if m != model_id][:MAX_ATTEMPTS - 1]

    for i, mid in enumerate(queue):
        try:
            result = _call_model(mid, msgs, max_tokens)
            if i > 0:
                print(f"  [FALLBACK] used {mid} (original: {model_id})")
            return result
        except Exception as e:
            print(f"  [FAIL {i+1}/{len(queue)}] {mid}: {str(e)[:120]}")

    print(f"  [ALL FAILED] {model_id} → static DEFEND")
    return _static_defend("All models failed.")


def _static_defend(reason: str) -> str:
    return json.dumps({
        "action_type": "DEFEND",
        "outcome_text": f"Static fallback: {reason}",
        "reasoning": reason,
        "prestige_impact": 0,
        "upward_report": "Sector stable.",
        "true_report": reason,
    })

