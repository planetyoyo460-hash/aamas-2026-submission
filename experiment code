# 9. WIN CONDITION CHECK
# ─────────────────────────────────────────────
TERRITORY_WIN_THRESHOLD = 85.0

def check_win_condition(
    blue: FactionState,
    green: FactionState,
    agents: dict,
    blue_static_turns: int,
    green_static_turns: int,
    BYZANTINE_TURNS: int = 3,
) -> str:
    if blue.territory_pct >= TERRITORY_WIN_THRESHOLD:
        return f"🔵 BLUE WINS — Territorial dominance ({blue.territory_pct:.1f}% controlled)!"
    if green.territory_pct >= TERRITORY_WIN_THRESHOLD:
        return f"🟢 GREEN WINS — Territorial dominance ({green.territory_pct:.1f}% controlled)!"

    # ── Mutual annihilation check (both sides hit 0 troops) ──────────────
    if blue.troops <= 0 and green.troops <= 0:
        terr_diff = blue.territory_pct - green.territory_pct
        if terr_diff > 10:
            return "🔵 BLUE WINS — Mutual annihilation, but Blue holds decisive territorial advantage!"
        elif terr_diff < -10:
            return "🟢 GREEN WINS — Mutual annihilation, but Green holds decisive territorial advantage!"
        else:
            return (
                f"⚪ DRAW — Mutual annihilation with no decisive territorial advantage "
                f"(Blue {blue.territory_pct:.1f}% / Green {green.territory_pct:.1f}%)!"
            )

    if blue.troops <= 0:
        return "🟢 GREEN WINS — Blue ground forces annihilated!"
    if green.troops <= 0:
        return "🔵 BLUE WINS — Green ground forces annihilated!"

    if blue_static_turns >= BYZANTINE_TURNS:
        return (
            f"🟢 GREEN WINS — Byzantine Failure: Blue command has lost all contact "
            f"with the battlefield for {blue_static_turns} consecutive turns!"
        )
    if green_static_turns >= BYZANTINE_TURNS:
        return (
            f"🔵 BLUE WINS — Byzantine Failure: Green command has lost all contact "
            f"with the battlefield for {green_static_turns} consecutive turns!"
        )

    return ""


def _faction_all_static(faction: str, agents: dict, turn_decisions: dict) -> bool:
    active = [a for a in agents.values()
              if a.faction == faction and not a.is_disqualified]
    if not active:
        return False
    for a in active:
        dec = turn_decisions.get(a.uid, {})
        outcome = dec.get("outcome_text", "")
        if not outcome.startswith("Static fallback"):
            return False
    return True


