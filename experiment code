def fetch_agent_decision(agent: Agent, turn: int, blue_sum: str, green_sum: str, inbox_sum: str):
    sys_p = DECISION_SYSTEM.format(
        role=agent.role, faction=agent.faction, rank_level=agent.rank_level(),
        prestige=agent.prestige, model_id=agent.model_id, doctrine=UNIFIED_WAR_DOCTRINE,
    )
    usr_p = (
        f"Turn {turn}. Blue: {blue_sum}. Green: {green_sum}. "
        f"Your domain: {agent.domain()}. "
        f"INTELLIGENCE THIS TURN:\n{inbox_sum}\n"
        f"Your memory (last 2 turns): {'; '.join(agent.memory[-2:]) or 'None.'}. "
        f"Choose your action and output JSON."
    )
    t0 = time.time()
    raw = call_model(agent.model_id, sys_p, usr_p, max_tokens=300)
    raw = raw.replace("```json", "").replace("```", "").strip()
    print(f"  [API] {agent.faction} {agent.role} ({agent.model_id}) {time.time()-t0:.1f}s")

    try:
        dec = json.loads(raw)
    except Exception:
        import re
        m = re.search(r'\{.*\}', raw, re.DOTALL)
        if m:
            try:
                dec = json.loads(m.group())
            except Exception:
                dec = None
        else:
            dec = None

    if not dec:
        dec = {
            "action_type": "DEFEND",
            "outcome_text": "Static fallback: Comms static — holding position.",
            "reasoning": f"Parse failed: {raw[:60]}",
            "prestige_impact": -3,
            "upward_report": "Sector stable.",
            "true_report": "Parse failure.",
        }
    return agent, dec

