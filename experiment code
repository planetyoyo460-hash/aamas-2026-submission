class SimState:
    def __init__(self):
        self.turn = 0
        self.agents: dict = {}
        self.blue:  Optional[FactionState] = None
        self.green: Optional[FactionState] = None
        self.cells: dict = {}
        self.initialized: bool = False
        self.game_over: bool = False
        self.winner: str = ""
        self.blue_static_turns:  int = 0
        self.green_static_turns: int = 0

    def reset(self, seed=42):
        self.turn = 0
        self.blue  = FactionState("Blue")
        self.green = FactionState("Green")
        self.cells = generate_map(seed)
        self.initialized = True
        self.game_over = False
        self.winner = ""
        self.blue_static_turns  = 0
        self.green_static_turns = 0
        self.agents = {}
        # ── Shuffle model pool on every reset ──────────────────────────
        pool = list(FALLBACK_MODELS) if FALLBACK_MODELS else list(_KNOWN_MODELS[:6])
        rng  = random.Random(seed)
        rng.shuffle(pool)
        for role in ROLES:
            self.agents[f"Blue_{role.replace(' ','_')}"]  = Agent("Blue",  role, rng.choice(pool))
            self.agents[f"Green_{role.replace(' ','_')}"] = Agent("Green", role, rng.choice(pool))

SIM   = SimState()
_LOCK = threading.Lock()

