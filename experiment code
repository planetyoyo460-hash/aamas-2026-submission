def _save_catalog_entry(entry: dict):
    """Append entry to catalog.json and regenerate catalog_summary.txt."""
    os.makedirs(AUTO_RUN_LOG_DIR, exist_ok=True)
    with _catalog_lock:
        catalog = _load_catalog()
        catalog.append(entry)
        with open(CATALOG_JSON_PATH, "w", encoding="utf-8") as f:
            json.dump(catalog, f, indent=2, ensure_ascii=False)
        _write_catalog_summary(catalog)


def _write_catalog_summary(catalog: list):
    """Write a human-readable catalog_summary.txt comparing all simulations."""
    sep  = "=" * 90
    sep2 = "-" * 90
    lines = [
        sep,
        "  WARGAME SIMULATION CATALOG",
        f"  Total simulations recorded: {len(catalog)}",
        f"  File: {CATALOG_JSON_PATH}",
        sep, "",
    ]

    model_wins:   dict[str, int] = {}
    model_played: dict[str, int] = {}
    blue_wins = green_wins = draw_wins = 0
    win_cond_counts: dict[str, int] = {}

    for e in catalog:
        wf = e.get("winner_faction", "")
        if wf == "Blue":
            blue_wins += 1
        elif wf == "Green":
            green_wins += 1
        elif wf == "Draw":
            draw_wins += 1

        wc = e.get("win_condition", "UNKNOWN")
        win_cond_counts[wc] = win_cond_counts.get(wc, 0) + 1

        for ms in e.get("model_stats", []):
            mid = ms["model"]
            model_played[mid] = model_played.get(mid, 0) + ms.get("turns_active", 0)

        # Credit the winning faction's models — draws credit nobody
        wfaction = e.get("winner_faction", "")
        if wfaction in ("Blue", "Green"):
            for ag in e.get("agents_final", []):
                if ag["faction"] == wfaction:
                    mid = ag["model"]
                    model_wins[mid] = model_wins.get(mid, 0) + 1

    lines += [
        "── OVERALL RESULTS ──────────────────────────────────────────────────────────────────",
        f"  🔵 Blue  victories : {blue_wins}",
        f"  🟢 Green victories : {green_wins}",
        f"  ⚪ Draws           : {draw_wins}",
        "",
        "  Win conditions:",
    ]
    for wc, cnt in sorted(win_cond_counts.items(), key=lambda x: -x[1]):
        lines.append(f"    {wc:<30} {cnt}x")

    avg_turns = sum(e["total_turns"] for e in catalog) / max(len(catalog), 1)
    avg_dur   = sum(e["duration_seconds"] for e in catalog) / max(len(catalog), 1)
    lines += [
        "",
        f"  Avg turns per simulation : {avg_turns:.1f}",
        f"  Avg duration (seconds)   : {avg_dur:.1f}",
        "", sep2, "",
    ]

    lines += ["── MODEL LEADERBOARD (by wins credited) ──────────────────────────────────────────"]
    all_models = sorted(set(list(model_wins.keys()) + list(model_played.keys())))
    lines.append(f"  {'Model':<45} {'Wins':>5}  {'Turns Active':>12}")
    lines.append(f"  {'-'*45} {'-----':>5}  {'------------':>12}")
    for mid in sorted(all_models, key=lambda m: -model_wins.get(m, 0)):
        lines.append(
            f"  {mid:<45} {model_wins.get(mid,0):>5}  {model_played.get(mid,0):>12}"
        )
    lines += ["", sep2, ""]

    lines += ["── SIMULATION INDEX ──────────────────────────────────────────────────────────────"]
    lines.append(
        f"  {'#':>4}  {'Seed':>6}  {'Turns':>5}  {'Winner':<8}  {'Win Condition':<24}"
        f"  {'BlueTerr':>8}  {'GreenTerr':>9}  {'Duration':>9}  Started"
    )
    lines.append("  " + "-" * 86)
    for e in catalog:
        wf   = e.get("winner_faction","?")
        if wf == "Blue":
            wf_icon = "🔵 B"
        elif wf == "Green":
            wf_icon = "🟢 G"
        else:
            wf_icon = "⚪ D"
        wc   = e.get("win_condition","?")[:22]
        bt   = e.get("blue_final",  {}).get("territory_pct", 0)
        gt   = e.get("green_final", {}).get("territory_pct", 0)
        dur  = e.get("duration_seconds", 0)
        sid  = e.get("sim_id", "?")
        seed = e.get("seed", "?")
        tur  = e.get("total_turns", "?")
        sta  = e.get("started_at","")[:19]
        lines.append(
            f"  {sid:>4}  {seed:>6}  {tur:>5}  {wf_icon:<8}  "
            f"{wc:<24}  {bt:>7.1f}%  {gt:>8.1f}%  {dur:>8.1f}s  {sta}"
        )
    lines += ["", sep]

    with open(CATALOG_TXT_PATH, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def _save_turn_log(sim_index: int, turn: int, log_text: str):
    """Write one turn's dossier to  wargame_logs/sim_<N>/turn_<T>.txt"""
    sim_dir = os.path.join(AUTO_RUN_LOG_DIR, f"sim_{sim_index:04d}")
    os.makedirs(sim_dir, exist_ok=True)
    path = os.path.join(sim_dir, f"turn_{turn:04d}.txt")
    with open(path, "w", encoding="utf-8") as f:
        f.write(log_text)


# ─────────────────────────────────────────────
# 16. AUTO-RUN LOOP
# ─────────────────────────────────────────────
_auto_run_active   = False
_auto_run_thread: Optional[threading.Thread] = None
_auto_run_lock     = threading.Lock()
_auto_status_box: list[str] = ["Auto-Run: Idle"]


def _auto_run_worker(seed_start: int):
    global _auto_run_active
    existing = _load_catalog()
    sim_index = existing[-1]["sim_id"] if existing else 0
    seed = seed_start

    while _auto_run_active:
        sim_index += 1
        started_at = time.strftime("%Y-%m-%d %H:%M:%S")
        t_start    = time.time()

        _auto_status_box[0] = f"Auto-Run ▶  Sim #{sim_index}  (seed={seed})  —  starting…"
        print(f"[AutoRun] ═══ Simulation #{sim_index} | seed={seed} ═══")

        with _LOCK:
            SIM.reset(seed)

        turn      = 0
        turn_logs = []

        while _auto_run_active and not SIM.game_over:
            turn += 1
            with _LOCK:
                SIM.turn = turn

            rng = random.Random(turn * 7919 + seed)

            log, winner, bst, gst = run_turn(
                turn, SIM.agents, SIM.blue, SIM.green, rng,
                SIM.blue_static_turns, SIM.green_static_turns,
            )

            with _LOCK:
                SIM.blue_static_turns  = bst
                SIM.green_static_turns = gst
                if winner:
                    SIM.game_over = True
                    SIM.winner    = winner

            actions_taken = []
            for a in SIM.agents.values():
                if a.memory and a.memory[-1].startswith(f"T{turn}:"):
                    mem = a.memory[-1]
                    atype = mem.split(":")[1].strip().split("—")[0].strip() if ":" in mem else "UNKNOWN"
                    actions_taken.append({
                        "faction":       a.faction,
                        "role":          a.role,
                        "model":         a.model_id,
                        "action_type":   atype,
                        "prestige_delta": 0,
                    })

            turn_logs.append({
                "turn":            turn,
                "blue_troops":     SIM.blue.troops,
                "blue_ships":      SIM.blue.ships,
                "blue_aircraft":   SIM.blue.aircraft,
                "blue_territory":  SIM.blue.territory_pct,
                "green_troops":    SIM.green.troops,
                "green_ships":     SIM.green.ships,
                "green_aircraft":  SIM.green.aircraft,
                "green_territory": SIM.green.territory_pct,
                "actions_taken":   actions_taken,
            })

            _save_turn_log(sim_index, turn, log)
            _auto_status_box[0] = (
                f"Auto-Run ▶  Sim #{sim_index} (seed={seed})  "
                f"Turn {turn}  |  Blue {SIM.blue.territory_pct:.1f}%  "
                f"Green {SIM.green.territory_pct:.1f}%"
                + (f"  →  {winner}" if winner else "")
            )

        ended_at         = time.strftime("%Y-%m-%d %H:%M:%S")
        duration_seconds = time.time() - t_start

        sim_dir      = os.path.join(AUTO_RUN_LOG_DIR, f"sim_{sim_index:04d}")
        summary_path = os.path.join(sim_dir, "summary.txt")
        os.makedirs(sim_dir, exist_ok=True)
        with open(summary_path, "w", encoding="utf-8") as f:
            f.write(f"Simulation #{sim_index} | seed={seed} | turns={turn}\n")
            f.write(f"Started : {started_at}\n")
            f.write(f"Ended   : {ended_at}\n")
            f.write(f"Duration: {duration_seconds:.1f}s\n")
            f.write(f"Winner  : {SIM.winner}\n\n")
            f.write(f"Blue  final: {SIM.blue.summary()}\n")
            f.write(f"Green final: {SIM.green.summary()}\n\n")
            f.write("Agents:\n")
            for a in sorted(SIM.agents.values(), key=lambda x: (x.faction, x.role)):
                dq = " [DQ]" if a.is_disqualified else ""
                f.write(f"  {a.faction} {a.role:<35} {a.model_id:<45} prestige={a.prestige:.0f}{dq}\n")

        entry = _build_catalog_entry(
            sim_index=sim_index,
            seed=seed,
            turn=turn,
            winner=SIM.winner,
            blue=SIM.blue,
            green=SIM.green,
            agents=SIM.agents,
            turn_logs=turn_logs,
            started_at=started_at,
            ended_at=ended_at,
            duration_seconds=duration_seconds,
        )
        _save_catalog_entry(entry)

        print(f"[AutoRun] Sim #{sim_index} finished in {turn} turns ({duration_seconds:.0f}s) → {SIM.winner}")
        seed += 1

    _auto_status_box[0] = f"Auto-Run ■  Stopped after {sim_index - (existing[-1]['sim_id'] if existing else 0)} simulation(s)."
    print("[AutoRun] Stopped.")


def toggle_auto_run(is_on: bool, seed_str: str) -> tuple[str, gr.update]:
    global _auto_run_active, _auto_run_thread

    seed = int(seed_str.strip()) if seed_str.strip().isdigit() else 42

    if is_on:
        if _auto_run_active:
            return "Already running.", gr.update(value=True)
        if not GITHUB_TOKEN:
            return "❌ GITHUB_TOKEN not set — cannot start Auto-Run.", gr.update(value=False)
        _auto_run_active = True
        _auto_run_thread = threading.Thread(
            target=_auto_run_worker, args=(seed,), daemon=True
        )
        _auto_run_thread.start()
        return f"▶ Auto-Run started (seed={seed}). Logs → {AUTO_RUN_LOG_DIR}", gr.update(value=True)
    else:
        _auto_run_active = False
        return "■ Auto-Run stopping (current turn will finish)…", gr.update(value=False)


def poll_auto_run_status() -> str:
    return _auto_status_box[0]


